# super-smash-bros-ultimate — example configuration.
# Copy to ".env" and fill in real values. NEVER commit your real .env.
NEXTENDO_HOST=0.0.0.0:60005
AUTH_PORT=443
SECURE_PORT=60005
NEXTENDO_PROXY_PROTOCOL=0
CERT_FILE=cert.pem
KEY_FILE=key.pem
NEXTENDO_ACCOUNT_URL=https://nextendo.network
NEXTENDO_REQUIRE_ACCOUNT=1
NEXTENDO_REQUIRE_SIGNED_TOKEN=0
NEXTENDO_INTERNAL_KEY=change-me
NEXTENDO_SECRET=change-me
NEXTENDO_SECRET_FILE=
NEXTENDO_SECURE_PASSWORD=change-me
NEXTENDO_SNI_HOST=
# Required installed title version, e.g. 13.0.5. Empty disables the check.
# Only emulator logins are checked; a real console never reports a version.
NEXTENDO_REQUIRED_VERSION=
# Result code an out-of-date client is refused with:
# unsupported | clientold | tokenparse. Default: Authentication::ApplicationVersionIsOld.
NEXTENDO_VERSION_REJECT_CODE=
